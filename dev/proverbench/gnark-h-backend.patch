@@ -0,0 +1,22 @@
+// Experimental extension; the CPU reference calls the unchanged pinned implementation.
+package groth16
+
+import (
+	"fmt"
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr"
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr/fft"
+)
+
+// HBackend returns exactly domain.Cardinality elements in bit-reversed order.
+// Inputs may be modified but must not be retained after return, including errors.
+type HBackend interface {
+	ComputeH(a, b, c []fr.Element, domain *fft.Domain) ([]fr.Element, error)
+}
+
+// ComputeHCPU exposes the original implementation as an independent test oracle.
+func ComputeHCPU(a, b, c []fr.Element, domain *fft.Domain) ([]fr.Element, error) {
+	if domain == nil || len(a) != len(b) || len(a) != len(c) || uint64(len(a)) > domain.Cardinality {
+		return nil, fmt.Errorf("invalid H input")
+	}
+	return computeH(a, b, c, domain), nil
+}
