+// Experimental extension to the pinned gnark fork; see dev/proverbench/GPU.md.
+package groth16
+
+import (
+	"github.com/consensys/gnark-crypto/ecc"
+	curve "github.com/consensys/gnark-crypto/ecc/bn254"
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr"
+)
+
+// MSMBackend supports concurrent calls and must not retain Go input buffers.
+// ProveWithMSM joins all work before returning, including on error.
+type MSMBackend interface {
+	G1(string, *curve.G1Jac, []curve.G1Affine, []fr.Element, ecc.MultiExpConfig) error
+	G2(string, *curve.G2Jac, []curve.G2Affine, []fr.Element, ecc.MultiExpConfig) error
+}
+
+func msmG1(e MSMBackend, name string, out *curve.G1Jac, points []curve.G1Affine, scalars []fr.Element, cfg ecc.MultiExpConfig) error {
+	if e != nil {
+		return e.G1(name, out, points, scalars, cfg)
+	}
+	_, err := out.MultiExp(points, scalars, cfg)
+	return err
+}
+func msmG2(e MSMBackend, name string, out *curve.G2Jac, points []curve.G2Affine, scalars []fr.Element, cfg ecc.MultiExpConfig) error {
+	if e != nil {
+		return e.G2(name, out, points, scalars, cfg)
+	}
+	_, err := out.MultiExp(points, scalars, cfg)
+	return err
+}
